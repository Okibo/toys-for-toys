# Toy-for-Toy Development Environment Configuration
#
# CRITICAL: Copy this file to .env.local and update values before running docker-compose
# NEVER commit .env.local to version control (it contains secrets)
#
# Setup instructions:
# 1. Copy this file: cp .env.local.example .env.local
# 2. Update all values marked [REQUIRED]
# 3. Keep dummy values for development unless otherwise noted
# 4. Run: docker-compose up -d
#
# Security Notes:
# - All values in .env.local are for DEVELOPMENT ONLY
# - Never use production credentials in development environments
# - Rotate JWT secrets regularly in production
# - Use strong, random passwords for production Postgres

# ==============================================================================
# PostgreSQL Configuration
# ==============================================================================
# Database connection settings for Supabase PostgreSQL service
# CRITICAL: These values must match docker-compose.yml environment variables

# PostgreSQL superuser username
# Default: postgres (sufficient for development)
POSTGRES_USER=postgres

# PostgreSQL superuser password
# Default: postgres (CHANGE IN PRODUCTION - use strong password)
# WARNING: This is publicly visible in docker-compose.yml - change for production
POSTGRES_PASSWORD=postgres

# PostgreSQL server hostname (used by services)
# Default: postgres (matches docker-compose service name)
POSTGRES_HOST=postgres

# PostgreSQL server port
# Default: 5432 (standard PostgreSQL port)
POSTGRES_PORT=5432

# Initial database name to create
# Default: postgres (will be used by all services)
POSTGRES_DB=postgres

# ==============================================================================
# PostgREST Configuration
# ==============================================================================
# API layer settings for REST API generation and JWT authentication

# JWT secret for signing and verifying tokens
# CRITICAL: Change this to a random string in production
# Generate with: openssl rand -hex 32
# Example: a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0
POSTGREST_JWT_SECRET=super-secret-jwt-token-change-in-production

# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Project settings and authentication keys

# Supabase project ID (for identification and configuration)
# For development: "dev" is fine
SUPABASE_PROJECT_ID=dev

# Supabase URL (where the API is hosted)
# For local development: http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://localhost:3000

# Supabase anon (anonymous) key
# Used by browser clients to authenticate requests
# In development: can be a placeholder value
# Production: must be a valid JWT token for your Supabase project
# Format: JWT token with payload: { "iss": "supabase", "ref": "project-ref", "role": "anon" }
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRldiIsInJvbGUiOiJhbm9uIiwiaWF0IjoxNjAwMDAwMDAwLCJleHAiOjE5MzAwMDAwMDB9.PLACEHOLDER_ANON_KEY

# Supabase service role key
# Used by backend API routes for elevated permissions
# CRITICAL: Keep this secret, never expose in frontend code
# Production: must be a valid JWT token with service_role claim
# Format: JWT token with payload: { "iss": "supabase", "ref": "project-ref", "role": "service_role" }
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRldiIsInJvbGUiOiJzZXJ2aWNlX3JvbGUiLCJpYXQiOjE2MDAwMDAwMDAsImV4cCI6MTkzMDAwMDAwMH0.PLACEHOLDER_SERVICE_ROLE_KEY

# ==============================================================================
# Email Service Configuration (SendGrid)
# ==============================================================================
# Transactional email for password resets, notifications, etc.

# SendGrid API key for sending emails
# [REQUIRED] Generate at: https://app.sendgrid.com/settings/api_keys
# Format: SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Leave empty in development if not testing email functionality
SENDGRID_API_KEY=

# Default "from" email address for SendGrid emails
# [REQUIRED] Must be verified in your SendGrid account
# Example: noreply@toy-for-toy.local
SENDGRID_FROM_EMAIL=noreply@toy-for-toy.local

# ==============================================================================
# Mailhog Configuration (Development Email Testing)
# ==============================================================================
# Local email service for capturing emails during development

# Mailhog SMTP server port
# Default: 1025 (standard development SMTP port)
# Configure your app to send emails to: localhost:1025
MAILHOG_SMTP_PORT=1025

# Mailhog Web UI port
# Default: 8025
# Access web UI at: http://localhost:8025
MAILHOG_UI_PORT=8025

# ==============================================================================
# Firebase Configuration
# ==============================================================================
# Push notifications, authentication, and analytics

# Firebase project ID
# [REQUIRED] Get from Firebase Console: https://console.firebase.google.com
# Example: toy-for-toy-prod
NEXT_PUBLIC_FIREBASE_PROJECT_ID=toy-for-toy-dev

# Firebase API key (public, safe for frontend)
# [REQUIRED] Get from Firebase Console → Project Settings → Web API Key
NEXT_PUBLIC_FIREBASE_API_KEY=

# Firebase authentication domain
# [REQUIRED] Format: {project-id}.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=toy-for-toy-dev.firebaseapp.com

# Firebase database URL (Realtime Database)
# [OPTIONAL] Only if using Realtime Database
# Format: https://{project-id}-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Firebase storage bucket
# [REQUIRED] Format: {project-id}.appspot.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=toy-for-toy-dev.appspot.com

# Firebase messaging sender ID (for FCM)
# [REQUIRED] Get from Firebase Console → Project Settings
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Firebase app ID
# [REQUIRED] Get from Firebase Console → Project Settings
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase measurement ID (Google Analytics)
# [OPTIONAL] Only if using Google Analytics
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK service account key (backend only)
# [REQUIRED] Download from Firebase Console → Project Settings → Service Accounts
# File path (relative to project root): ./firebase-adminsdk-key.json
# CRITICAL: Never commit this file to version control
FIREBASE_ADMIN_SDK_KEY_PATH=./firebase-adminsdk-key.json

# ==============================================================================
# Next.js Configuration
# ==============================================================================
# Application behavior and feature flags

# Node environment (development, production, test)
# Default: development
NODE_ENV=development

# Next.js image optimization
# Default: false (disable in dev for faster builds)
NEXT_PUBLIC_DISABLE_IMAGE_OPTIMIZATION=true

# Vercel Analytics (if using Vercel hosting)
# [OPTIONAL] Enable Web Vitals tracking
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# ==============================================================================
# Capacitor Configuration (Mobile Development)
# ==============================================================================
# Settings for Capacitor (iOS/Android native wrapper)

# Capacitor platform (web, android, ios)
# Default: web (set to android or ios when building mobile)
CAPACITOR_PLATFORM=web

# ==============================================================================
# Application URLs and Endpoints
# ==============================================================================
# External service endpoints (used by frontend and backend)

# Current application base URL
# For local development: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API endpoint (used by frontend)
# For local development with docker-compose: http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Supabase API URL (alternative endpoint for specific services)
# Usually same as NEXT_PUBLIC_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_API_URL=http://localhost:3000

# ==============================================================================
# Monitoring & Analytics
# ==============================================================================
# Optional monitoring and logging services

# Sentry error tracking (if implementing)
# [OPTIONAL] DSN from: https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=

# LogRocket session recording (if implementing)
# [OPTIONAL] App ID from: https://logrocket.com
NEXT_PUBLIC_LOGROCKET_APP_ID=

# ==============================================================================
# Feature Flags & Development Settings
# ==============================================================================
# Control experimental features and development behavior

# Enable detailed error messages
# Default: false (set to true for debugging)
NEXT_PUBLIC_DEBUG=false

# Enable mock data in development
# Default: true (use real API data when false)
NEXT_PUBLIC_USE_MOCK_DATA=true

# Enable verbose logging
# Default: false
DEBUG_VERBOSE=false

# ==============================================================================
# Database Seeding
# ==============================================================================
# Optional: seed initial data when container starts

# Enable database seeding
# Default: false
POSTGRES_INIT_SEED=false

# Seed file location (relative to project root)
# Default: supabase/seed.sql
POSTGRES_SEED_FILE=supabase/seed.sql

# ==============================================================================
# PRODUCTION DEPLOYMENT NOTES
# ==============================================================================
#
# Before deploying to production:
#
# 1. Rotate ALL secrets:
#    - POSTGRES_PASSWORD (use strong random string)
#    - POSTGREST_JWT_SECRET (use `openssl rand -hex 32`)
#    - Firebase keys (regenerate in Firebase Console)
#    - SendGrid API key
#
# 2. Use environment-specific values:
#    - POSTGRES_HOST (must be production DB hostname)
#    - NEXT_PUBLIC_SUPABASE_URL (must be production URL)
#    - Disable POSTGRES_INIT_SEED
#
# 3. Enable security headers:
#    - CORS for specific origins only
#    - HTTPS enforcement
#    - Secure cookie flags
#
# 4. Configure external services:
#    - Firebase production credentials
#    - SendGrid production API key
#    - SSL/TLS certificates
#
# 5. Backup strategy:
#    - Daily automated backups
#    - Backup encryption
#    - Test restore procedures
#
# 6. Monitoring:
#    - Enable error tracking (Sentry)
#    - Enable performance monitoring
#    - Set up alerts for critical errors
