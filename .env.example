# Supabase Configuration (EU Region for GDPR Compliance)
# See docs/DATABASE.md for setup instructions
# Replace these with your actual Supabase project credentials

# Public variables (safe to expose in frontend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-anon-key-here
NEXT_PUBLIC_SUPABASE_REGION=eu-west-1

# Private variables (server-side only, NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-service-role-key-here

# Firebase Cloud Messaging (FCM) Configuration
# SCOPE: Push notifications ONLY
# Database, Auth, and Storage are handled by Supabase (NOT Firebase)
# See docs/ENV_SETUP_GUIDE.md for detailed setup instructions
# See docs/FIREBASE_SECURITY.md for security best practices

# PUBLIC VARIABLES - Safe to expose in browser (NEXT_PUBLIC_* prefix)
# These are restricted in Firebase Console and cannot access sensitive resources
# Source: Firebase Console > Project Settings > General (Web app config)

# Firebase API key - restricted key for web clients only (NOT the unrestricted key)
# Format: Starts with "AIzaSy", example: "AIzaSyDummyKey1234567890ABCDEFGHIJK"
# Used for Cloud Messaging initialization only
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyXxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Firebase project ID - usually matches your Firebase Console project name
# Format: lowercase alphanumeric with hyphens, example: "toys-for-toys-mvp"
# Used for Cloud Messaging initialization only
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Cloud Messaging sender ID - used for push notifications
# Format: numeric string, example: "123456789012345"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012345

# Firebase app ID - identifies this specific app instance
# Format: "1:sender-id:web:app-id", example: "1:123456789012:web:abc123def456ghi789"
# Used for Cloud Messaging initialization only
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012345:web:abc123def456ghi789

# PRIVATE VARIABLES - Server-side only, NEVER expose to browser
# These contain sensitive credentials that can access all Firebase resources
# Never use NEXT_PUBLIC_ prefix for these variables
# Source: Firebase Console > Project Settings > Service Accounts > Generate New Private Key

# Firebase Admin SDK Service Account Key - CRITICAL SECURITY
# This contains your Firebase service account credentials with FULL ACCESS to Firebase
# Must be kept strictly private and only accessible on server
# Format: Entire service account JSON as a single-line string (use single quotes)
# Example format (DO NOT USE THIS - it's just showing the structure):
# FIREBASE_ADMIN_SDK_KEY='{"type":"service_account","project_id":"your-project","private_key_id":"key-id","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com","client_id":"123456789","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/..."}'
FIREBASE_ADMIN_SDK_KEY='{"type":"service_account","project_id":"your-project-id",...}'

# SECURITY NOTES:
# - NEVER commit .env.local to Git (it's in .gitignore)
# - NEVER share FIREBASE_ADMIN_SDK_KEY via email, Slack, or GitHub
# - NEVER log or expose FIREBASE_ADMIN_SDK_KEY in error messages
# - Keep .env.local with restricted permissions: chmod 600 .env.local
# - Rotate service account key quarterly for security
# - See docs/FIREBASE_SECURITY_CHECKLIST.md before production deployment

# Application Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SendGrid Configuration
# Get your API key from https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here

# Optional: Other Third-party Services
# GOOGLE_ANALYTICS_ID=your-analytics-id
# SENTRY_DSN=your-sentry-dsn
